var label la0 = label.new(0, 0, "0°", xloc = xloc.bar_time, color = color.orange, textcolor = color.black, size = size.small)
var label la1 = label.new(0, 0, "360°", xloc = xloc.bar_time, color = color.orange, textcolor = color.black, size = size.small)
label.set_xy(la0, nz(t0), nz(p0))
label.set_xy(la1, nz(t1), nz(p1))
label.set_style(la0, cycleDown ? label.style_label_down : label.style_label_up)
label.set_style(la1, cycleDown ? label.style_label_up : label.style_label_down)

// ===== Time cycle lines (previous + next 3) =====
var line tl0 = line.new(0, 0, 0, 1, xloc = xloc.bar_time, extend = extend.both, color = color.new(cTime, 30), style = line.style_dashed)
var label tb0 = label.new(0, 0, "", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(cTime, 80), textcolor = cTime, size = size.small)
int tt0 = tk(kNext - 1 + 0)
line.set_xy1(tl0, nz(tt0), nz(math.min(p0, p1)))
line.set_xy2(tl0, nz(tt0), nz(math.min(p0, p1)) * 1.001)
line.set_color(tl0, showTime and not na(tt0) ? color.new(cTime, 30) : color.new(cTime, 100))
label.set_xy(tb0, nz(tt0), nz(math.min(p0, p1)))
label.set_text(tb0, showTime and not na(tt0) ? "T " + str.tostring((kNext - 1 + 0) * timeStep) + "°\n" + fmtT(tt0) : "")
label.set_color(tb0, showTime and not na(tt0) ? color.new(cTime, 80) : color.new(cTime, 100))
var line tl1 = line.new(0, 0, 0, 1, xloc = xloc.bar_time, extend = extend.both, color = color.new(cTime, 30), style = line.style_dashed)
var label tb1 = label.new(0, 0, "", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(cTime, 80), textcolor = cTime, size = size.small)
int tt1 = tk(kNext - 1 + 1)
line.set_xy1(tl1, nz(tt1), nz(math.min(p0, p1)))
line.set_xy2(tl1, nz(tt1), nz(math.min(p0, p1)) * 1.001)
line.set_color(tl1, showTime and not na(tt1) ? color.new(cTime, 30) : color.new(cTime, 100))
label.set_xy(tb1, nz(tt1), nz(math.min(p0, p1)))
label.set_text(tb1, showTime and not na(tt1) ? "T " + str.tostring((kNext - 1 + 1) * timeStep) + "°\n" + fmtT(tt1) : "")
label.set_color(tb1, showTime and not na(tt1) ? color.new(cTime, 80) : color.new(cTime, 100))
var line tl2 = line.new(0, 0, 0, 1, xloc = xloc.bar_time, extend = extend.both, color = color.new(cTime, 30), style = line.style_dashed)
var label tb2 = label.new(0, 0, "", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(cTime, 80), textcolor = cTime, size = size.small)
int tt2 = tk(kNext - 1 + 2)
line.set_xy1(tl2, nz(tt2), nz(math.min(p0, p1)))
line.set_xy2(tl2, nz(tt2), nz(math.min(p0, p1)) * 1.001)
line.set_color(tl2, showTime and not na(tt2) ? color.new(cTime, 30) : color.new(cTime, 100))
label.set_xy(tb2, nz(tt2), nz(math.min(p0, p1)))
label.set_text(tb2, showTime and not na(tt2) ? "T " + str.tostring((kNext - 1 + 2) * timeStep) + "°\n" + fmtT(tt2) : "")
label.set_color(tb2, showTime and not na(tt2) ? color.new(cTime, 80) : color.new(cTime, 100))
var line tl3 = line.new(0, 0, 0, 1, xloc = xloc.bar_time, extend = extend.both, color = color.new(cTime, 30), style = line.style_dashed)
var label tb3 = label.new(0, 0, "", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(cTime, 80), textcolor = cTime, size = size.small)
int tt3 = tk(kNext - 1 + 3)
line.set_xy1(tl3, nz(tt3), nz(math.min(p0, p1)))
line.set_xy2(tl3, nz(tt3), nz(math.min(p0, p1)) * 1.001)
line.set_color(tl3, showTime and not na(tt3) ? color.new(cTime, 30) : color.new(cTime, 100))
label.set_xy(tb3, nz(tt3), nz(math.min(p0, p1)))
label.set_text(tb3, showTime and not na(tt3) ? "T " + str.tostring((kNext - 1 + 3) * timeStep) + "°\n" + fmtT(tt3) : "")
label.set_color(tb3, showTime and not na(tt3) ? color.new(cTime, 80) : color.new(cTime, 100))

// ===== Projected path arrow =====
var line arw = line.new(0, 0, 0, 0, xloc = xloc.bar_time, color = cArrow, width = 2, style = line.style_arrow_right)
var label arl = label.new(0, 0, "", xloc = xloc.bar_time, color = cArrow, textcolor = color.black, size = size.small)
int tEnd = na(tNext) ? time_close + 20 * (time_close - time) : tNext
bool arrOn = showArrow and not na(tg1)
line.set_xy1(arw, time, close)
line.set_xy2(arw, tEnd, nz(tg1, close))
line.set_color(arw, arrOn ? cArrow : color.new(cArrow, 100))
label.set_xy(arl, tEnd, nz(tg1, close))
label.set_text(arl, arrOn ? "الهدف " + fmtP(tg1) : "")
label.set_color(arl, arrOn ? cArrow : color.new(cArrow, 100))
label.set_style(arl, biasDir > 0 ? label.style_label_down : label.style_label_up)

// ===== Scenario panel =====
var table panel = table.new(panelPos == "Top right" ? position.top_right : panelPos == "Top left" ? position.top_left : panelPos == "Bottom right" ? position.bottom_right : position.bottom_left, 2, 15, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1, frame_color = color.gray, frame_width = 1)
color hc = color.new(color.orange, 20)
color bc = biasDir > 0 ? color.new(color.green, 40) : biasDir < 0 ? color.new(color.red, 40) : color.new(color.gray, 40)
float nb0 = math.min(ab(bsl1, close), ab(bsl2, close))
float ns0 = math.max(be(ssl1, close), be(ssl2, close))
float nearBsl = nb0 >= 1e11 ? na : nb0
float nearSsl = ns0 <= -1e11 ? na : ns0
string liqTxt = "BSL " + fmtP(nearBsl) + " | SSL " + fmtP(nearSsl) + (sweepActive ? (sweepDir > 0 ? "\nسحب قيعان حديث ▲" : "\nسحب قمم حديث ▼") : "") + (hasVol ? "\nحجم نسبي " + str.tostring(rvol, "#.#") + "x · OBV " + (obv > obvMa ? "▲" : "▼") : "\n(لا يوجد حجم تداول لهذا الرمز)")
table.cell(panel, 0, 0, "تحليل التلاقي", text_color = color.black, bgcolor = hc, text_size = size.small)
table.cell(panel, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.black, bgcolor = hc, text_size = size.small)
table.cell(panel, 0, 1, "الفريمات الأكبر", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 1, tf1 + " " + trendTxt(h1) + "  |  " + tf2 + " " + trendTxt(h2) + "  |  " + tf3 + " " + trendTxt(h3), text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 2, "الفريم الحالي", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 2, trendTxt(ctTrend), text_color = trendCol(ctTrend), bgcolor = na, text_size = size.small)
table.cell(panel, 0, 3, "RSI", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 3, str.tostring(rsi, "#.0") + (bullDiv ? "  دايفرجنس إيجابي" : "") + (bearDiv ? "  دايفرجنس سلبي" : ""), text_color = rsi > 55 ? color.lime : rsi < 45 ? color.red : color.silver, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 4, "فيبوناتشي", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 4, fibTxt, text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 5, "السيولة", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 5, liqTxt, text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 6, "الدورة الرقمية", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 6, (cycleDown ? "هابطة" : "صاعدة") + " · السعر عند " + str.tostring(math.round(degAt(close))) + "°", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 7, "دعم / مقاومة", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 7, fmtL(sup) + "\n" + fmtL(res), text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 8, "النتيجة", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 8, biasTxt + "  ·  " + str.tostring(score, "#.#") + " / " + str.tostring(maxScore, "#.#") + "  ·  ثقة " + str.tostring(conf, "#") + "%", text_color = color.white, bgcolor = bc, text_size = size.small)
table.cell(panel, 0, 9, "السيناريو المتوقع", text_color = color.yellow, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 9, scen, text_color = color.yellow, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 10, "الهدف الأول", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 10, fmtL(tg1), text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 11, "الهدف الثاني", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 11, fmtL(tg2), text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 12, "إلغاء السيناريو", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 12, biasDir == 0 ? "—" : (biasDir > 0 ? "إغلاق تحت " : "إغلاق فوق ") + fmtL(inv), text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 13, "الموعد الزمني", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 13, timeTxt, text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 0, 14, "الأسباب", text_color = color.white, bgcolor = na, text_size = size.small)
table.cell(panel, 1, 14, reasons, text_color = color.silver, bgcolor = na, text_size = size.small)

// ===== Alerts =====
alertcondition(biasDir != biasDir[1], "Scenario changed / تغير السيناريو", "{{ticker}}: Gann scenario changed")
alertcondition(bullSweep, "Sell-side liquidity swept / سحب سيولة القيعان", "{{ticker}}: sell-side liquidity swept")
alertcondition(bearSweep, "Buy-side liquidity swept / سحب سيولة القمم", "{{ticker}}: buy-side liquidity swept")
