// Gann + Fib + Liquidity + RSI + MTF Scenario (mobile-safe: no indentation)
// التحليل الرقمي والزمني + فيبوناتشي + السيولة + RSI + الفريمات الأكبر
//@version=6
indicator("Gann + Fib + Liquidity + RSI + MTF Scenario", "GannMobile", overlay = true, max_lines_count = 50, max_labels_count = 100, max_bars_back = 5000)

// ===== Inputs =====
const string G1 = "Anchors / نقاط الارتكاز"
anchorMode = input.string("Auto", "Anchor mode / طريقة الارتكاز", options = ["Auto", "Manual"], group = G1)
lookback = input.int(300, "Auto: lookback bars / عدد الشموع", minval = 10, maxval = 5000, group = G1)
mStart = input.price(0.0, "Manual: 0° price", group = G1)
mStartT = input.time(timestamp("2026-01-01T00:00+00:00"), "Manual: 0° time", group = G1)
mEnd = input.price(0.0, "Manual: 360° price", group = G1)
mEndT = input.time(timestamp("2026-01-02T00:00+00:00"), "Manual: 360° time", group = G1)
const string G2 = "Gann / الرقمي"
const string PM_RANGE = "Range: 0° → 360° between anchors"
const string PM_SQ9 = "Square of 9 from 0° anchor"
showPrice = input.bool(true, "Show Gann levels", group = G2)
priceMode = input.string(PM_RANGE, "Method / الطريقة", options = [PM_RANGE, PM_SQ9], group = G2)
stepDeg = input.int(36, "Degree step / خطوة الدرجات", options = [15, 30, 36, 45, 60, 90], group = G2)
const string G3 = "Time cycle / الدورة الزمنية"
const string TM_ANCHOR = "Anchor-to-anchor duration = 360°"
const string TM_DAY = "1° = 1 calendar day"
const string TM_FIXED = "Fixed cycle (days) = 360°"
showTime = input.bool(true, "Show time lines", group = G3)
timeMode = input.string(TM_ANCHOR, "Method / الطريقة", options = [TM_ANCHOR, TM_DAY, TM_FIXED], group = G3)
fixedDays = input.float(30.0, "Fixed cycle length (days)", minval = 0.1, group = G3)
timeStep = input.int(90, "Time degree step", options = [30, 36, 45, 60, 90, 120, 180, 360], group = G3)
tz = input.string("Asia/Riyadh", "Timezone / المنطقة الزمنية", group = G3)
const string G4 = "Fib / Liquidity / RSI"
showFib = input.bool(true, "Show Fibonacci", group = G4)
showLiq = input.bool(true, "Show liquidity (BSL / SSL)", group = G4)
pivLen = input.int(5, "Swing pivot length", minval = 2, maxval = 50, group = G4)
sweepLook = input.int(10, "Sweep valid for (bars)", minval = 1, group = G4)
rvolLen = input.int(20, "Relative volume length", minval = 5, group = G4)
rsiLen = input.int(14, "RSI length", minval = 2, group = G4)
divLook = input.int(30, "Divergence valid for (bars)", minval = 5, group = G4)
const string G5 = "Higher timeframes / الفريمات الأكبر"
tfMode = input.string("Auto", "Higher TFs", options = ["Auto", "Manual"], group = G5)
mTf1 = input.timeframe("60", "Manual HTF 1", group = G5)
mTf2 = input.timeframe("240", "Manual HTF 2", group = G5)
mTf3 = input.timeframe("D", "Manual HTF 3", group = G5)
const string G6 = "Scenario / السيناريو"
showArrow = input.bool(true, "Show projected arrow", group = G6)
tolMult = input.float(0.35, "Confluence tolerance (x ATR)", minval = 0.05, step = 0.05, group = G6)
panelPos = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G6)
c360 = input.color(color.red, "Gann 360°", group = G6)
c90 = input.color(color.blue, "Gann 90°", group = G6)
cMinor = input.color(color.gray, "Gann other", group = G6)
cFib = input.color(color.purple, "Fibonacci", group = G6)
cBsl = input.color(color.red, "BSL", group = G6)
cSsl = input.color(color.green, "SSL", group = G6)
cTime = input.color(color.white, "Time lines", group = G6)
cArrow = input.color(color.yellow, "Arrow", group = G6)

// ===== Core =====
float atr = ta.atr(14)
float tol = atr * tolMult
float emaF = ta.ema(close, 20)
float emaS = ta.ema(close, 50)
float rsi = ta.rsi(close, rsiLen)
bool hasVol = ta.cum(nz(volume)) > 0
float rvol = hasVol ? volume / ta.sma(volume, rvolLen) : na
float obv = ta.obv
float obvMa = ta.ema(obv, 20)

// ===== Higher timeframes =====
int secs = timeframe.in_seconds()
string aTf1 = secs <= 300 ? "15" : secs <= 900 ? "60" : secs <= 3600 ? "240" : secs <= 14400 ? "D" : secs <= 86400 ? "W" : "M"
string aTf2 = secs <= 300 ? "60" : secs <= 900 ? "240" : secs <= 3600 ? "D" : secs <= 14400 ? "W" : "M"
string aTf3 = secs <= 300 ? "240" : secs <= 900 ? "D" : secs <= 3600 ? "W" : "M"
string tf1 = tfMode == "Auto" ? aTf1 : mTf1
string tf2 = tfMode == "Auto" ? aTf2 : mTf2
string tf3 = tfMode == "Auto" ? aTf3 : mTf3
htfTrend(string tf) => request.security(syminfo.tickerid, tf, close > ta.ema(close, 50) and ta.ema(close, 20) > ta.ema(close, 50) ? 1 : close < ta.ema(close, 50) and ta.ema(close, 20) < ta.ema(close, 50) ? -1 : 0)
int h1 = nz(htfTrend(tf1))
int h2 = nz(htfTrend(tf2))
int h3 = nz(htfTrend(tf3))
int ctTrend = close > emaS and emaF > emaS ? 1 : close < emaS and emaF < emaS ? -1 : 0

// ===== Anchors (0° = older extreme, 360° = newer extreme) =====
int hiOff = nz(-ta.highestbars(high, lookback))
int loOff = nz(-ta.lowestbars(low, lookback))
bool useManual = anchorMode == "Manual" and mStart > 0 and mEnd > 0
bool autoDown = hiOff > loOff
bool ready = useManual or bar_index >= lookback
float p0 = useManual ? mStart : ready ? (autoDown ? high[hiOff] : low[loOff]) : na
float p1 = useManual ? mEnd : ready ? (autoDown ? low[loOff] : high[hiOff]) : na
int t0 = useManual ? mStartT : ready ? (autoDown ? time[hiOff] : time[loOff]) : na
int t1 = useManual ? mEndT : ready ? (autoDown ? time[loOff] : time[hiOff]) : na
bool cycleDown = p1 < p0

// ===== Gann levels =====
lvl(int d) => na(p0) or na(p1) ? na : priceMode == PM_RANGE ? math.pow(math.max(0.0, math.sqrt(p0) + (math.sqrt(p1) - math.sqrt(p0)) * d / 360.0), 2) : math.pow(math.max(0.0, math.sqrt(p0) + (p1 < p0 ? -1.0 : 1.0) * d / 180.0), 2)
degAt(float x) => priceMode == PM_RANGE ? (math.sqrt(x) - math.sqrt(p0)) / (math.sqrt(p1) - math.sqrt(p0)) * 360.0 : (math.sqrt(x) - math.sqrt(p0)) * 180.0 * (p1 < p0 ? -1.0 : 1.0)
gCol(int k) => k * stepDeg > 0 and (k * stepDeg) % 360 == 0 ? c360 : (k * stepDeg) % 90 == 0 ? c90 : cMinor
gName(int k) => "جان " + str.tostring(k * stepDeg) + "°"
float g0 = lvl(0 * stepDeg)
float g1 = lvl(1 * stepDeg)
float g2 = lvl(2 * stepDeg)
float g3 = lvl(3 * stepDeg)
float g4 = lvl(4 * stepDeg)
float g5 = lvl(5 * stepDeg)
float g6 = lvl(6 * stepDeg)
float g7 = lvl(7 * stepDeg)
float g8 = lvl(8 * stepDeg)
float g9 = lvl(9 * stepDeg)
float g10 = lvl(10 * stepDeg)
float g11 = lvl(11 * stepDeg)
float g12 = lvl(12 * stepDeg)
float g13 = lvl(13 * stepDeg)
float g14 = lvl(14 * stepDeg)
float g15 = lvl(15 * stepDeg)

// ===== Fibonacci on the same swing (0 = 360° end, 1 = 0° start) =====
fib(float r) => p1 + (p0 - p1) * r
float f1 = fib(0.236)
float f2 = fib(0.382)
float f3 = fib(0.5)
float f4 = fib(0.618)
float f5 = fib(0.786)
float fe1 = fib(-0.272)
float fe2 = fib(-0.618)

// ===== Liquidity: last 2 unswept swing highs (BSL) and lows (SSL) + sweeps =====
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
var float bsl1 = na
var float bsl2 = na
var float ssl1 = na
var float ssl2 = na
bsl2 := not na(ph) ? bsl1 : bsl2
bsl1 := not na(ph) ? ph : bsl1
ssl2 := not na(pl) ? ssl1 : ssl2
ssl1 := not na(pl) ? pl : ssl1
bool brkB1 = not na(bsl1) and high > bsl1
bool brkB2 = not na(bsl2) and high > bsl2
bool brkS1 = not na(ssl1) and low < ssl1
bool brkS2 = not na(ssl2) and low < ssl2
float bearLvl = brkB1 and close < bsl1 ? bsl1 : brkB2 and close < bsl2 ? bsl2 : na
float bullLvl = brkS1 and close > ssl1 ? ssl1 : brkS2 and close > ssl2 ? ssl2 : na
bool bearSweep = not na(bearLvl)
bool bullSweep = not na(bullLvl)
bsl1 := brkB1 ? na : bsl1
bsl2 := brkB2 ? na : bsl2
ssl1 := brkS1 ? na : ssl1
ssl2 := brkS2 ? na : ssl2
var int sweepBar = na
var int sweepDir = 0
var float sweepLvl = na
sweepDir := bullSweep ? 1 : bearSweep ? -1 : sweepDir
sweepLvl := bullSweep ? bullLvl : bearSweep ? bearLvl : sweepLvl
sweepBar := bullSweep or bearSweep ? bar_index : sweepBar
bool sweepActive = not na(sweepBar) and bar_index - sweepBar <= sweepLook

// ===== RSI divergence =====
float rPiv = rsi[pivLen]
var float prevPlP = na
var float prevPlR = na
var float prevPhP = na
var float prevPhR = na
var int bullDivBar = na
var int bearDivBar = na
bullDivBar := not na(pl) and not na(prevPlP) and pl < prevPlP and rPiv > prevPlR ? bar_index : bullDivBar
bearDivBar := not na(ph) and not na(prevPhP) and ph > prevPhP and rPiv < prevPhR ? bar_index : bearDivBar
prevPlR := not na(pl) ? rPiv : prevPlR
prevPlP := not na(pl) ? pl : prevPlP
prevPhR := not na(ph) ? rPiv : prevPhR
prevPhP := not na(ph) ? ph : prevPhP
bool bullDiv = not na(bullDivBar) and bar_index - bullDivBar <= divLook
bool bearDiv = not na(bearDivBar) and bar_index - bearDivBar <= divLook

// ===== Nearest levels from all sources (no loops) =====
ab(float v, float x) => v > x ? v : 1e12
be(float v, float x) => v < x ? v : -1e12
nu(float x) => math.min(ab(g0, x), ab(g1, x), ab(g2, x), ab(g3, x), ab(g4, x), ab(g5, x), ab(g6, x), ab(g7, x), ab(g8, x), ab(g9, x), ab(g10, x), ab(g11, x), ab(g12, x), ab(g13, x), ab(g14, x), ab(g15, x), ab(f1, x), ab(f2, x), ab(f3, x), ab(f4, x), ab(f5, x), ab(fe1, x), ab(fe2, x), ab(bsl1, x), ab(bsl2, x), ab(ssl1, x), ab(ssl2, x))
nd(float x) => math.max(be(g0, x), be(g1, x), be(g2, x), be(g3, x), be(g4, x), be(g5, x), be(g6, x), be(g7, x), be(g8, x), be(g9, x), be(g10, x), be(g11, x), be(g12, x), be(g13, x), be(g14, x), be(g15, x), be(f1, x), be(f2, x), be(f3, x), be(f4, x), be(f5, x), be(fe1, x), be(fe2, x), be(bsl1, x), be(bsl2, x), be(ssl1, x), be(ssl2, x))
nextUp(float x) => na(x) or nu(x) >= 1e11 ? na : nu(x)
nextDn(float x) => na(x) or nd(x) <= -1e11 ? na : nd(x)
hit(float v, float x) => not na(v) and not na(x) and math.abs(v - x) <= tol
nm1(float v, float x, string n) => hit(v, x) ? n + " | " : ""
cn1(float v, float x) => hit(v, x) ? 1 : 0
namesAt(float x) => nm1(g0, x, gName(0)) + nm1(g1, x, gName(1)) + nm1(g2, x, gName(2)) + nm1(g3, x, gName(3)) + nm1(g4, x, gName(4)) + nm1(g5, x, gName(5)) + nm1(g6, x, gName(6)) + nm1(g7, x, gName(7)) + nm1(g8, x, gName(8)) + nm1(g9, x, gName(9)) + nm1(g10, x, gName(10)) + nm1(g11, x, gName(11)) + nm1(g12, x, gName(12)) + nm1(g13, x, gName(13)) + nm1(g14, x, gName(14)) + nm1(g15, x, gName(15)) + nm1(f1, x, "فيبو 0.236") + nm1(f2, x, "فيبو 0.382") + nm1(f3, x, "فيبو 0.5") + nm1(f4, x, "فيبو 0.618") + nm1(f5, x, "فيبو 0.786") + nm1(fe1, x, "فيبو امتداد 1.272") + nm1(fe2, x, "فيبو امتداد 1.618") + nm1(bsl1, x, "سيولة BSL") + nm1(bsl2, x, "سيولة BSL") + nm1(ssl1, x, "سيولة SSL") + nm1(ssl2, x, "سيولة SSL")
countAt(float x) => cn1(g0, x) + cn1(g1, x) + cn1(g2, x) + cn1(g3, x) + cn1(g4, x) + cn1(g5, x) + cn1(g6, x) + cn1(g7, x) + cn1(g8, x) + cn1(g9, x) + cn1(g10, x) + cn1(g11, x) + cn1(g12, x) + cn1(g13, x) + cn1(g14, x) + cn1(g15, x) + cn1(f1, x) + cn1(f2, x) + cn1(f3, x) + cn1(f4, x) + cn1(f5, x) + cn1(fe1, x) + cn1(fe2, x) + cn1(bsl1, x) + cn1(bsl2, x) + cn1(ssl1, x) + cn1(ssl2, x)
fmtP(float x) => na(x) ? "—" : str.tostring(x, format.mintick)
fmtT(int t) => na(t) ? "—" : str.format_time(t, "EEE dd MMM yy HH:mm", tz)
fmtL(float x) => na(x) ? "—" : fmtP(x) + (countAt(x) > 0 ? "  (" + namesAt(x) + ")" : "")
trendTxt(int t) => t > 0 ? "▲ صاعد" : t < 0 ? "▼ هابط" : "◆ محايد"
trendCol(int t) => t > 0 ? color.lime : t < 0 ? color.red : color.silver

// ===== Scoring: every component votes =====
float rsiSig = (rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0) + (rsi > 70 ? -0.5 : rsi < 30 ? 0.5 : 0.0) + (bullDiv ? 1.0 : 0.0) + (bearDiv ? -1.0 : 0.0)
float fibPos = p0 != p1 ? (close - p1) / (p0 - p1) : na
bool inGolden = fibPos >= 0.5 and fibPos <= 0.618
bool deepRet = fibPos > 0.786
float fibSig = inGolden ? (cycleDown ? -1.0 : 1.0) : deepRet ? (cycleDown ? 1.0 : -1.0) : 0.0
string fibTxt = na(fibPos) ? "—" : (fibPos < 0 ? "امتداد بعد نهاية الدورة" : fibPos < 0.382 ? "ارتداد ضعيف" : fibPos < 0.5 ? "ارتداد متوسط" : fibPos <= 0.618 ? "المنطقة الذهبية 0.5–0.618" : fibPos <= 0.786 ? "ارتداد عميق" : fibPos <= 1 ? "قرب بداية الدورة" : "تجاوز بداية الدورة") + " (" + str.tostring(fibPos, "#.###") + ")"
float sup = nextDn(close)
float res = nextUp(close)
bool atSup = not na(sup) and low <= sup + tol and close > sup
bool atRes = not na(res) and high >= res - tol and close < res
float lvlSig = atSup ? (countAt(sup) > 1 ? 1.5 : 1.0) : atRes ? (countAt(res) > 1 ? -1.5 : -1.0) : 0.0
float liqSig = sweepActive ? sweepDir * 1.5 : 0.0
float volSig = hasVol ? (obv > obvMa ? 0.5 : -0.5) + (rvol > 1.5 ? (close > open ? 0.5 : -0.5) : 0.0) : 0.0
float score = h1 * 1.0 + h2 * 1.0 + h3 * 1.5 + ctTrend * 1.0 + rsiSig + fibSig + lvlSig + liqSig + volSig
float maxScore = 3.5 + 1.0 + 2.0 + 1.0 + 1.5 + 1.5 + (hasVol ? 1.0 : 0.0)
int biasDir = score >= 1.0 ? 1 : score <= -1.0 ? -1 : 0
float conf = math.min(100.0, math.abs(score) / maxScore * 100.0)
string biasTxt = score >= 3.0 ? "صاعد قوي ▲▲" : score >= 1.0 ? "صاعد ▲" : score <= -3.0 ? "هابط قوي ▼▼" : score <= -1.0 ? "هابط ▼" : "محايد ◆"
int htfUp = (h1 > 0 ? 1 : 0) + (h2 > 0 ? 1 : 0) + (h3 > 0 ? 1 : 0)
int htfDn = (h1 < 0 ? 1 : 0) + (h2 < 0 ? 1 : 0) + (h3 < 0 ? 1 : 0)
string reasons = "• الفريمات الأكبر: " + str.tostring(htfUp) + " صاعد / " + str.tostring(htfDn) + " هابط\n" + (bullDiv ? "• دايفرجنس إيجابي على RSI\n" : "") + (bearDiv ? "• دايفرجنس سلبي على RSI\n" : "") + (rsi > 70 ? "• RSI تشبع شراء\n" : "") + (rsi < 30 ? "• RSI تشبع بيع\n" : "") + (inGolden ? "• السعر في المنطقة الذهبية لفيبوناتشي\n" : "") + (deepRet ? "• ارتداد أعمق من 0.786 → ضعف اتجاه الدورة\n" : "") + (atSup ? "• ارتداد من دعم " + fmtL(sup) + "\n" : "") + (atRes ? "• رفض من مقاومة " + fmtL(res) + "\n" : "") + (sweepActive ? (sweepDir > 0 ? "• سحب سيولة القيعان عند " : "• سحب سيولة القمم عند ") + fmtP(sweepLvl) + "\n" : "") + (hasVol and rvol > 1.5 ? "• حجم تداول مرتفع " + str.tostring(rvol, "#.#") + "x\n" : "")

// ===== Targets, invalidation, time =====
float tg1 = biasDir > 0 ? nextUp(close + tol) : biasDir < 0 ? nextDn(close - tol) : na
float tg2 = na(tg1) ? na : biasDir > 0 ? nextUp(tg1 + tol) : nextDn(tg1 - tol)
float inv = biasDir > 0 ? nextDn(close - tol) : biasDir < 0 ? nextUp(close + tol) : na
float cycMs = timeMode == TM_ANCHOR ? float(t1 - t0) : timeMode == TM_DAY ? 360.0 * 86400000.0 : fixedDays * 86400000.0
float stepMs = cycMs * timeStep / 360.0
int kNext = na(t0) or na(stepMs) or stepMs <= 0 ? na : int(math.floor((time_close - t0) / stepMs)) + 1
tk(int k) => na(k) ? na : t0 + int(stepMs * k)
int tNext = tk(kNext)
string timeTxt = na(tNext) ? "—" : "T " + str.tostring(kNext * timeStep) + "°: " + fmtT(tNext)
string scen = biasDir > 0 ? "الأفضلية للصعود نحو " + fmtP(tg1) + (na(tg2) ? "" : " ثم " + fmtP(tg2)) + "\nحتى الموعد الزمني " + fmtT(tNext) + "\nبشرط الثبات فوق " + fmtP(inv) : biasDir < 0 ? "الأفضلية للهبوط نحو " + fmtP(tg1) + (na(tg2) ? "" : " ثم " + fmtP(tg2)) + "\nحتى الموعد الزمني " + fmtT(tNext) + "\nبشرط البقاء تحت " + fmtP(inv) : "تذبذب بين " + fmtP(sup) + " و " + fmtP(res) + "\nانتظر إغلاقاً خارج النطاق\nالموعد الزمني القادم " + fmtT(tNext)

// ===== Plots: levels as horizontal lines =====
plot(showPrice ? g0 : na, "Gann 0", color = gCol(0), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g1 : na, "Gann 1", color = gCol(1), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g2 : na, "Gann 2", color = gCol(2), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g3 : na, "Gann 3", color = gCol(3), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g4 : na, "Gann 4", color = gCol(4), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g5 : na, "Gann 5", color = gCol(5), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g6 : na, "Gann 6", color = gCol(6), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g7 : na, "Gann 7", color = gCol(7), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g8 : na, "Gann 8", color = gCol(8), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g9 : na, "Gann 9", color = gCol(9), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g10 : na, "Gann 10", color = gCol(10), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g11 : na, "Gann 11", color = gCol(11), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g12 : na, "Gann 12", color = gCol(12), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g13 : na, "Gann 13", color = gCol(13), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g14 : na, "Gann 14", color = gCol(14), trackprice = true, show_last = 1, editable = false)
plot(showPrice ? g15 : na, "Gann 15", color = gCol(15), trackprice = true, show_last = 1, editable = false)
plot(showFib ? f1 : na, "Fib 0.236", color = cFib, trackprice = true, show_last = 1, editable = false)
plot(showFib ? f2 : na, "Fib 0.382", color = cFib, trackprice = true, show_last = 1, editable = false)
plot(showFib ? f3 : na, "Fib 0.5", color = cFib, trackprice = true, show_last = 1, editable = false)
plot(showFib ? f4 : na, "Fib 0.618", color = cFib, trackprice = true, show_last = 1, editable = false)
plot(showFib ? f5 : na, "Fib 0.786", color = cFib, trackprice = true, show_last = 1, editable = false)
plot(showFib ? fe1 : na, "Fib -0.272", color = cFib, trackprice = true, show_last = 1, editable = false)
plot(showFib ? fe2 : na, "Fib -0.618", color = cFib, trackprice = true, show_last = 1, editable = false)
plot(showLiq ? bsl1 : na, "BSL1", color = cBsl, trackprice = true, show_last = 1, editable = false)
plot(showLiq ? bsl2 : na, "BSL2", color = cBsl, trackprice = true, show_last = 1, editable = false)
